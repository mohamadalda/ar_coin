# Salin jadi .env di VPS, lalu isi.
# Domain HARUS sudah mengarah ke IP VPS sebelum container dinyalakan:
# Caddy memverifikasi kepemilikan lewat HTTP, dan verifikasi itu gagal kalau
# DNS-nya belum menunjuk ke sini.
DOMAIN=imago.peruri.co.id

# Dipakai Let's Encrypt untuk memberitahumu kalau perpanjangan sertifikat gagal.
ACME_EMAIL=mohamad.alda@peruri.co.id
