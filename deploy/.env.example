# Salin jadi .env di VPS, lalu isi.

# Nama yang dilayani. Harus resolve ke VPS ini dari perangkat yang mengaksesnya.
DOMAIN=imago.peruri.co.id

# Sumber sertifikat.
#
#   internal   CA milik Caddy sendiri. Pilihan untuk server yang hanya ada di
#              DNS internal, seperti ini. Root CA-nya perlu dipasang sekali di
#              setiap perangkat yang dipakai mencoba.
#
#   /certs/imago.crt /certs/imago.key
#              Sertifikat dari CA internal Peruri, bila tersedia. LEBIH BAIK:
#              root CA-nya biasanya sudah terpasang di perangkat kantor,
#              sehingga tidak ada yang perlu dipasang manual.
TLS_MODE=internal

# Hanya relevan bila nanti memakai Let's Encrypt. Diabaikan saat TLS_MODE
# bernilai internal atau menunjuk berkas sertifikat.
ACME_EMAIL=email-kamu@peruri.co.id
