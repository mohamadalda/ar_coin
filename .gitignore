# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
tool/.venv/

# Kunci penandatanganan Android — JANGAN pernah ikut ter-commit.
android/key.properties

# Pustaka web pihak ketiga, diambil saat build oleh tool/fetch_web_vendor.sh.
/web/vendor/

# Konfigurasi per-server; yang masuk git hanya deploy/.env.example.
deploy/.env

# Kunci service account Firebase (dipakai tool/set_admin_claim.py).
*service-account*.json
*-firebase-adminsdk-*.json
.firebase/
firebase-debug.log
**/*.jks
**/*.keystore

# ---- Sertifikat dan kunci privat ----
# JANGAN PERNAH masuk riwayat git. Riwayat git disalin ke setiap clone dan
# setiap fork, dan menghapusnya belakangan tidak menarik kembali salinan yang
# sudah tersebar — kunci yang pernah ter-commit harus dianggap bocor dan
# diterbitkan ulang.
deploy/cert/
deploy/certs/
# Dokumen tindak lanjut pentest berklasifikasi Rahasia — tidak masuk git.
docs/TINDAK_LANJUT_PENTEST_IMAGO.md
PR_DESCRIPTION.md

# Arsip kiriman sertifikat (mis. deploy/cert.zip) biasanya berisi kunci privat.
deploy/*.zip
*.key
*.pem
*.pfx
*.p12
